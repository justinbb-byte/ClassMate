# Phase 1 runs without Supabase credentials.
DATABASE_URL=                         # Supabase transaction pooler, port 6543
DIRECT_URL=                           # Supabase session/direct pooler, port 5432 (Phase 2 migrations)
INGEST_API_KEY=change-me              # Required for /api/ingest/*
USE_MOCK=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
